#include <windows.h>

1 ICON "deskcontrol.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,1,0,0
 PRODUCTVERSION 2,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName", "DeskControl"
      VALUE "FileDescription", "DeskControl - control your PC with a game controller"
      VALUE "FileVersion", "2.1.0"
      VALUE "ProductVersion", "2.1.0"
      VALUE "LegalCopyright", "GPL v3. Based on Gopher360 by Tylemagne."
      VALUE "OriginalFilename", "DeskControl.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
